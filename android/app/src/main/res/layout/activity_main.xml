<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Apple Navigation Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="Unplug Emblem"
                    android:src="@drawable/unplug_logo_emblem" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="-0.03"
                        android:text="Un"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="-0.03"
                        android:text="plug"
                        android:textColor="@color/accent_mint"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Apple Style Streak Badge -->
            <TextView
                android:id="@+id/tvStreak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_glass_btn_secondary"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="🔥 3 Day Streak"
                android:textColor="@color/ios_orange"
                android:textSize="13sp" />
        </RelativeLayout>

        <!-- Main Apple Health / Fitness Style Glass Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="28dp">

            <!-- 3D Mascot Avatar -->
            <ImageView
                android:id="@+id/imgMainMascot"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:contentDescription="Brain Mascot"
                android:scaleType="centerCrop"
                android:src="@drawable/brain_healthy" />

            <!-- Apple Large Number Display -->
            <TextView
                android:id="@+id/tvMainReelCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.03"
                android:text="0 / 50"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:textStyle="bold" />

            <!-- Pill Mood Tag -->
            <TextView
                android:id="@+id/tvMainStateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_glass_btn_secondary"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="● Healthy &amp; Happy"
                android:textColor="@color/ios_green"
                android:textSize="13sp" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/pbReelProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="24dp"
                android:max="50"
                android:progress="0"
                android:progressTint="@color/ios_green" />
        </LinearLayout>

        <!-- Permissions Section Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.08"
            android:text="SETUP &amp; PERMISSIONS"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <!-- Apple Settings Style Grouped Glass Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp">

            <!-- Accessibility Permission Item -->
            <RelativeLayout
                android:id="@+id/btnAccessibilityPerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/tvAccessibilityStatus"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="1. Accessibility Service"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Counts reels when you scroll in apps"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAccessibilityStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_glass_btn_primary"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Enable"
                    android:textColor="@color/black"
                    android:textSize="13sp" />
            </RelativeLayout>

            <!-- Thin Glass Separator -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/glass_border_subtle" />

            <!-- Overlay Permission Item -->
            <RelativeLayout
                android:id="@+id/btnOverlayPerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/tvOverlayStatusBtn"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="2. Dynamic Island Overlay"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Floating live capsule on Instagram"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvOverlayStatusBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_glass_btn_primary"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Enable"
                    android:textColor="@color/black"
                    android:textSize="13sp" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Daily Limit Section Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.08"
            android:text="DAILY LIMIT"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <!-- Apple Segmented Daily Limit Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Block reels after:"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvCurrentLimit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_btn_secondary"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="50 reels ▾"
                android:textColor="@color/ios_cyan"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Test & Reset Quick Actions -->
        <Button
            android:id="@+id/btnResetToday"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_glass_btn_secondary"
            android:fontFamily="sans-serif-medium"
            android:text="Reset Counter (Test Mode)"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
